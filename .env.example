# Default STT provider used by examples.
CALL_SCRIBE_STT_PROVIDER=eleven-labs
CALL_SCRIBE_OUTPUT_DIR=docs/meetings
CALL_SCRIBE_CAPTURE_DIR=data/discord-captures
# Optional SQLx-backed Postgres runtime store for sessions, artifacts, and audit events.
CALL_SCRIBE_DATABASE_URL=
# Private-alpha organization that owns Discord captures (multi-tenant prep).
CALL_SCRIBE_ORGANIZATION_ID=org_private_alpha
# record-only (default) | auto-transcribe
CALL_SCRIBE_CAPTURE_MODE=record-only
# Control-plane API (`call-scribe serve`)
CALL_SCRIBE_API_BIND=0.0.0.0:8080
CALL_SCRIBE_MEETINGS_DIR=meetings
# Local private-alpha auth subject (Bearer token or auto session)
CALL_SCRIBE_DEV_AUTH_SUB=
CALL_SCRIBE_OIDC_ISSUER=
CALL_SCRIBE_OIDC_AUDIENCE=

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_TIMEOUT_SECONDS=900
ELEVENLABS_STT_DIARIZE=true
ELEVENLABS_STT_TAG_AUDIO_EVENTS=true

# Optional OpenAI transcription and analysis. Requires API access.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe

# Optional text-analysis model override.
OPENAI_MODEL=gpt-5.5

# Discord capture adapter. Requires `cargo run --features discord -- discord ...`.
DISCORD_TOKEN=
# Optional trigger user. When set with CALL_SCRIBE_DISCORD_CHANNEL_ID, this user
# starts and stops capture for that channel; other speakers are still recorded.
CALL_SCRIBE_DISCORD_USER_ID=
CALL_SCRIBE_DISCORD_GUILD_ID=
CALL_SCRIBE_DISCORD_CHANNEL_ID=
