# Required. Use a Discord bot token installed in your guild with permission to
# view and connect to the target voice or stage channel.
DISCORD_TOKEN=

# Required for the default ElevenLabs transcription provider.
ELEVENLABS_API_KEY=

# Optional. compose.yaml already points at its bundled Postgres service.
# Leave unset unless you are using an external database.
# CALL_SCRIBE_DATABASE_URL=postgres://call_scribe:call_scribe@postgres:5432/call_scribe

# Required Discord server and voice/stage channel identifiers.
CALL_SCRIBE_DISCORD_GUILD_ID=
CALL_SCRIBE_DISCORD_CHANNEL_ID=

# Hosted alternative to the static guild/channel values above. Set both or
# neither; store the workload token in a secrets manager in production.
# CALL_SCRIBE_HOSTED_CONTROL_PLANE_URL=https://callscribe.example.com
# CALL_SCRIBE_HOSTED_WORKLOAD_TOKEN=
# CALL_SCRIBE_HOSTED_OUTBOX_ENCRYPTION_KEY=
# CALL_SCRIBE_HOSTED_WORKER_ID=call-scribe-worker

# Optional overrides.
# CALL_SCRIBE_STT_PROVIDER=eleven-labs
# ELEVENLABS_STT_TIMEOUT_SECONDS=900
# ELEVENLABS_STT_DIARIZE=true
# ELEVENLABS_STT_TIMESTAMPS_GRANULARITY=word
